# SETTINGS
PREFIX="pm!"
PREFIX_TEST="pmt!"
OWNER="462098932571308033"
SERVER_ID="1033551490331197462" # Used for anything server-specific.
CLEANUP_FOLDER_TEMP="true" # Deletes all files in the temp directory on reboot. Doesnt apply in test mode
CONNECTIVITY_CHECK_FOR_OFFLINE="true" # Waits until we can fetch discord.com before logging in. Intended to check for the host's internet connectivity, this is NOT built to handle Discord API outages.
CONNECTIVITY_CHECK_MAX="50" # max amounts of checks before we just give up and panic
CONNECTIVITY_CHECK_DELAY="60000" # ms between connectivity checks
RESPOND_TO_KEYWORDS="true"
ADD_MEMBER_ROLE_ON_JOIN="false" # Adds the configuration memberRole to members who join SERVER_ID
USE_MOD_TIP_DMS="true" # Enable or disable the modtip mod mail system. Dont use pm!modtip if this is disabled.
USE_SPACES_REACTION_ROLES="false" # Enable or disable reaction roles in the configuration spaces channel. Delete the reactionrole commands if this is disabled.
USE_RESTART_MESSAGE="true" # On pm!restart, Reply to the  restartMessage in the restartChannel if present in state.serialized
REPORT_AUTOMOD_BYPASS="true"
REPORT_BAN_TO_USER="true" # DM users when they are banned
REPORT_BAN_TO_WEBHOOK="true" # Send bans to the BAN_LOG_WEBHOOK
REPORT_INAPPROPRIATE_INVITES="true"
PREVENT_UPDATES="false"
DISABLE_GIT="false" # disables the use of Git CLI (for commands like pm!pull)
DISABLE_GIT_WRITE="false" # disables the use of Git CLI for writing to a repo (for commands like pm!push)
DISABLE_ARBITRARY_OS_LEVEL_CODE="false" # Disables the eval & installmodule commands
DISABLE_FORKING="false" # Disables the use of multi-threading in the multi-thread module, specifically child_process.fork()
STATE_DEFAULT_PANELFORCEDDISABLED="false" # sets panelForcedDisabled on startup

